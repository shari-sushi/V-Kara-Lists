{
  "permissions": {
    "allow": [
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__github__get_me"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/check-dangerous-command.py"
          }
        ]
      }
    ]
  }
}
